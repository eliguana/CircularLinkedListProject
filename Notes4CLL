class Node {
public:
    int data;       //stores an integer
    Node* next;     //Pointer to another Node

    Node(int val) : data(val), next(nullptr) {} 
    };
    
    /****************************
    -> line 17: same as writing: 
    Node(int val) {  //constructor
    data = val;      //initializes the data
    next = nullptr;  //initially points to nothing
    
    ******************************/

    void traversal(Node* head) {
    Node* current = head;           //Start at first Node

    do {
        cout << current->data << " ";   // "current->data" accesses the data stored in the current node
        current = current->next;        //Moves to the next node
    } while (current != head);      
    
    // "!=" -> not equal operator, this operator checks to see if the pointer has traveled all the way around the circle and arrived back to the starting node. A long as current!=head is true, the loop keeps running, printing, and advancing to the next node. The moment it evaluates to false, the operator recognizes every node has been visited, and loop ends

    //do-while loop forces the pointer to move at least once before != and checks if it has completed the loop and returned to the head.

    cout << endl;
}

void traversalInLoop(Node* head) {
    Node* current = head;
    int k = 10;                 // will print 10 nodes

    	while (current != nullptr && k--) {
            

        /********************************************************************
         // " -- " is the decrement operator, which is used to decrease the value of a variable by 1
         // k-- acts as a loop counter that controls how many steps the traversal takes, repeats while the previous value of k is nonzero
        ********************************************************************/

        //Loop stops if k reaches 0 or if we hit the end of the list (nullptr)
        cout << current->data << " ";
        current = current->next;        
        
       /********************************************************************
       current is a pointer holding a memory address, this arrow operator then grabs the mem address of the next node and reassigns it to current,
        which physically moves pointer to next link in the chain
        ********************************************************************/
    }
    cout << endl;
}

void insertAtStart(Node*& head, int value) {	
    
    /********************************************************************
    // ^^reads from right to left, so head is passed by reference
    // to update/change the head pointer in the main(). " *& " places 
    // a reference on a pointer type declaration
    ********************************************************************/
	
    Node* newNode = new Node(value);            //newNode is a pointer to Node
	if (head == nullptr) {                      //Checks if head is equal to nullptr
		newNode->next = newNode;                // Point to itself if the list is empty
		head = newNode;                         //Assigns value of head to newNode
		return;
	}
	Node* current = head;
	while (current->next != head) {
		current = current->next;
	}
	current->next = newNode;                    //changing the link from the last node to the head node
	newNode->next = head;                       //making the new node point to the head node
	head = newNode;                             //updating the head pointer to point to the new node
}

